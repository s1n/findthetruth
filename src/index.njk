---
layout: base.njk
title: Find The Truth
---
<section class="hero">
  <h1>{{ site.title }}</h1>
  <p class="hero__subtitle">{{ site.subtitle }}</p>
  <p class="hero__lede">{{ site.description }}</p>
  <p><a class="btn" href="/lore/">Enter the archive</a></p>
</section>

<section class="ai-intro">
  <div class="ai-intro__sig" aria-hidden="true">
    {% for line in site.ai.signal %}<p>&gt;&gt; {{ line }}</p>{% endfor %}
    <p>&gt;&gt; {{ site.ai.tagline }}</p>
  </div>
  <blockquote class="ai-intro__msg">
    {% for para in site.ai.transmission %}<p>{{ para | safe }}</p>{% endfor %}
  </blockquote>
  <p class="ai-intro__slogan">{{ site.ai.slogan }}</p>
  <p class="ai-intro__invite">{{ site.ai.invite }} <a href="/lore/">Enter the archive &rarr;</a></p>
</section>
